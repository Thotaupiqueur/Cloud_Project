{
  "uid": "unita-analytics",
  "title": "UNITA - Learning Analytics",
  "tags": ["unita", "learning-analytics"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": { "from": "now-30d", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Utilisateurs inscrits",
      "datasource": { "type": "mysql", "uid": "mariadb-edudata" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "mysql", "uid": "mariadb-edudata" },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(ID) AS utilisateurs FROM wp_users"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Cours publies",
      "datasource": { "type": "mysql", "uid": "mariadb-edudata" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "mysql", "uid": "mariadb-edudata" },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(ID) AS cours FROM wp_posts WHERE post_type = 'lp_course' AND post_status = 'publish'"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Inscriptions par jour",
      "datasource": { "type": "mysql", "uid": "mariadb-edudata" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "mysql", "uid": "mariadb-edudata" },
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT UNIX_TIMESTAMP(DATE(user_registered)) AS time, COUNT(ID) AS inscriptions FROM wp_users GROUP BY DATE(user_registered) ORDER BY DATE(user_registered)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars", "fillOpacity": 80, "barAlignment": 0, "lineWidth": 1 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Derniers inscrits",
      "datasource": { "type": "mysql", "uid": "mariadb-edudata" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 6 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "mysql", "uid": "mariadb-edudata" },
          "format": "table",
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT ID AS id, user_login AS login, display_name AS nom, user_email AS email, user_registered AS inscrit_le FROM wp_users ORDER BY user_registered DESC LIMIT 10"
        }
      ],
      "options": { "showHeader": true, "cellHeight": "sm" },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    }
  ]
}
